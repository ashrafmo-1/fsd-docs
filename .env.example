# Public Supabase settings for dashboard authentication.
# Copy this file to .env.local and fill in the values from the Supabase dashboard.
# Never add the service-role key, database password, or admin password to this file.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# New Supabase projects label the public key "publishable".
# You can set this instead of NEXT_PUBLIC_SUPABASE_ANON_KEY.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Comma-separated Supabase Auth user UUIDs that may open /dashboard.
# Authentication → Users → User UID. Do not prefix this with NEXT_PUBLIC_.
DASHBOARD_ADMIN_USER_IDS=
